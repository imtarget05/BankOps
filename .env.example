# QuanLyKho Environment Configuration
# Copy to .env and fill in REAL values (never commit .env)
APP_ENV=demo
DATABASE_URL=postgresql+asyncpg://bankops:bankops@postgres:5432/bankops

# AI Provider Configuration
AI_PROVIDER=${AI_PROVIDER:-cloudflare}
AI_TIMEOUT_SECONDS=120
AI_REQUESTS_PER_MINUTE=30

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=8788242370433563100da7c3623e1b3c
CLOUDFLARE_API_TOKEN=REPLACE_WITH_YOUR_CLOUDFLARE_API_TOKEN
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Ollama / Local LLM (Qwen2.5-1.5B)
OLLAMA_BASE_URL=http://localhost:11434
