# =============================================================================
# Dockerfile — Model Serving API (Phase M — S9)
# =============================================================================
# FastAPI inference endpoint với model đã Promotion sang Production.
# - Non-root user
# - Resource limits rõ ràng
# - Health check endpoints
# - Multi-stage build: builder → runtime
# - Model artifact pinned qua ENV
# =============================================================================
FROM python:3.11-slim AS builder

# Install system dependencies required for build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Create non-root user
RUN groupadd --gid 1000 appuser && \
    useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash appuser

# Install Python dependencies into isolated path
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e ".[main]"

# =============================================================================
# Runtime stage
# =============================================================================
FROM python:3.11-slim AS runtime

# Install minimal runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /usr/local /usr/local
# Copy application code
COPY app/ app/
COPY Dockerfile.serving .

# Switch to non-root user
USER appuser

# Environment variables
ENV MLFLOW_TRACKING_URI="sqlite:///./mlflow.db"
ENV MODEL_NAME="DemandForecastModel"
ENV PYTHONUNBUFFERED=1
ENV PORT=8000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Entry point
CMD ["uvicorn", "app.api.inference:app", "--host", "0.0.0.0", "--port", "8000"]