# BankOps Backend Environment Configuration

# Application
APP_ENV=demo
APP_NAME=BankOps-API

# Database
DATABASE_URL=postgresql+psycopg2://bankops:bankops@postgres:5432/bankops

# JWT Authentication
JWT_SIGNING_KEY_REF=dev_signing_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Idempotency
IDEMPOTENCY_KEY_RETENTION_HOURS=24

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true

# Integration
CONNECTOR_SECRET_REF=connector_secrets_ref
SSE_RETENTION_DAYS=7
STAGING_TTL_HOURS=24

# Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15

# SMTP is optional in local demo. Leave all values blank to keep email delivery
# disabled; the password-reset flow will report that email is unavailable.
# Set these only in a gitignored local env file or your deployment secret store.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=

# AI provider credentials are optional for local demo. Do not commit values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
