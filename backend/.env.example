# Quản Lý Kho Trà Sữa Backend Environment Configuration

# Application
APP_ENV=demo
APP_NAME=quan-ly-kho-tra-sua-api

# Database
# Database (demo local). Thay bằng giá trị thật khi deploy.
DATABASE_URL=postgresql+psycopg2://kho-tra-sua:kho-tra-sua@postgres:5432/kho-tra-sua

# JWT Authentication
JWT_SIGNING_KEY_REF=dev_signing_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-domain.example.com

# Idempotency
IDEMPOTENCY_KEY_RETENTION_HOURS=24

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true

# Integration
CONNECTOR_SECRET_REF=connector_secrets_ref
SSE_RETENTION_DAYS=7
STAGING_TTL_HOURS=24

# Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15

# SMTP is optional in local demo. Leave all values blank to keep email delivery
# disabled; the password-reset flow will report that email is unavailable.
# Set these only in a gitignored local env file or your deployment secret store.
# (`SMTP_USER`/`SMTP_PASSWORD` để TRỐNG = "chưa cấu hình" — app tự bỏ qua
# email. Điền giá trị thật ở file .env gitignored hoặc trong secret store.)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=

# ---- Canonical secrets (2026-10-21 rotation wave) ------------------------
# Tên chuẩn, PHẢI khớp với `backend/app/config.py` và với k8s Secret
# (`infra/k8s/base/secret-template.yaml`). Ở non-demo, app FAIL-FAST nếu
# thiếu `BANKOPS_SIGNING_KEY` / `BANKOPS_SESSION_SECRET`.
# Ở đây CHỈ được để PLACEHOLDER — không bao giờ commit giá trị thật.
# Sinh key mới: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BANKOPS_SIGNING_KEY=CHANGE_ME_GENERATE_32_BYTE_RANDOM_SIGNING_KEY
BANKOPS_SESSION_SECRET=CHANGE_ME_GENERATE_32_BYTE_RANDOM_SESSION_SECRET
# PIN 6 số của Kiểm soát viên (duyệt phiếu quỹ giá trị cao).
SUPERVISOR_PIN=CHANGE_ME_SUPERVISOR_PIN

# `SECRET_KEY` là tên LEGACY (DEPRECATED) của secret deploy: KHÔNG phải tên
# chuẩn, KHÔNG dùng làm fallback âm thầm cho `BANKOPS_SIGNING_KEY`.
# `backend/entrypoint.sh` chỉ còn fallback legacy ở APP_ENV=demo/dev/test
# (kèm cảnh báo lớn); production/staging thiếu `BANKOPS_SIGNING_KEY` thì
# container FAIL-FAST. Đừng khai báo `SECRET_KEY` ở đây.

# AI provider credentials are optional for local demo. Do not commit values.

# ---- AI / LLM provider ----
# Mặc định `disabled` để dev không bị chặn khi chưa cấu hình LLM.
# Production/staging (APP_ENV=production|staging) bắt buộc set một trong ba:
#   cloudflare : CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN
#   ollama     : OLLAMA_BASE_URL + OLLAMA_MODEL
#   modal_llm  : MODAL_LLM_URL + MODAL_LLM_MODEL
# Lưu ý: không dùng mô hình fine-tune cũ trên máy làm giá trị tạm; deploy
# LLM lên HF -> Modal trước khi set ai_provider=modal_llm.
AI_PROVIDER=disabled

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Ollama local (chỉ dev)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Modal space LLM (deploy HF -> Modal)
MODAL_LLM_URL=
MODAL_LLM_MODEL=Qwen2.5-1.5B-Instruct.Q4_K_M

# Langfuse AI Observability (opt-in)
# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

