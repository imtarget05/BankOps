APP_ENV=demo
APP_NAME=BankOps-API
DATABASE_URL=postgresql+asyncpg://bankops:bankops@postgres:5432/bankops
JWT_SIGNING_KEY_REF=dev_signing_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=REPLACE_WITH_YOUR_ALLOWED_ORIGINS
IDEMPOTENCY_KEY_RETENTION_HOURS=24
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true
CONNECTOR_SECRET_REF=connector_secrets_ref
SSE_RETENTION_DAYS=7
STAGING_TTL_HOURS=24
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
BANKOPS_SESSION_SECRET=REPLACE_WITH_YOUR_BANKOPS_SESSION_SECRET
BANKOPS_SIGNING_KEY=REPLACE_WITH_YOUR_BANKOPS_SIGNING_KEY
SUPERVISOR_PIN=REPLACE_WITH_YOUR_SUPERVISOR_PIN

FRONTEND_BASE_URL=https://quan-ly-kho-tra-sua.tanmainguyenbinh.workers.dev

# System Mailer (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_YOUR_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_YOUR_GMAIL_APP_PASSWORD
SMTP_FROM_NAME=Ban Quản Trị Hệ Thống

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=REPLACE_WITH_YOUR_CLOUDFLARE_API_TOKEN
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
AI_PROVIDER=cloudflare
AI_TIMEOUT_SECONDS=120
AI_REQUESTS_PER_MINUTE=30

# DEPRECATED: SECRET_KEY (legacy) — KHÔNG khai báo giá trị, chỉ giữ comment
# để nhắc rotate sang BANKOPS_SIGNING_KEY / BANKOPS_SESSION_SECRET
# SECRET_KEY=

DEMO_MODE=true

# Langfuse AI Observability (Live Cloud)
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=REPLACE_WITH_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=REPLACE_WITH_LANGFUSE_SECRET_KEY
LANGFUSE_HOST="https://cloud.langfuse.com"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"